  "agents": {
    "hierarchy": {
      "level_1": "SUPER_AGENT_ORQUESTRADOR (este prompt)",
      "level_2": [
        "AGENT_LLM_ROUTER - Roteia entre providers",
        "AGENT_CHATBOT - Interação com usuário via WhatsApp",
        "AGENT_CARTORIO - Lógica de negócio cartorária",
        "AGENT_OBSERVABILITY - Monitoramento e alertas"
      ],
      "level_3": [
        "SUBAGENT_FALLBACK - Gerencia fallback entre LLMs",
        "SUBAGENT_RAG - Retrieval Augmented Generation",
        "SUBAGENT_MEMORY - Gerenciamento de memória/contexto",
        "SUBAGENT_COMPLIANCE - Validação LGPD/cartório",
        "SUBAGENT_HUMAN_HANDOFF - Escalonamento humano"
      ]
    },
    "communication": {
      "protocol": "MCP (Model Context Protocol)",
      "message_format": "JSON-RPC 2.0",
      "persistence": "Redis + PostgreSQL"
    }
  },
  "tasks": {
    "automation_rules": [
      {
        "trigger": "mensagem_whatsapp_recebida",
        "action": "AGENT_CHATBOT.processar()",
        "fallback": "AGENT_HUMAN_HANDOFF.escalar()",
        "timeout": "30s"
      },
      {
        "trigger": "llm_provider_offline",
        "action": "SUBAGENT_FALLBACK.trocar_provider()",
        "fallback": "SUBAGENT_FALLBACK.usar_local_ollama()",
        "timeout": "10s"
      },
      {
        "trigger": "acao_critica_cartorio",
        "action": "SUBAGENT_COMPLIANCE.validar()",
        "fallback": "AGENT_HUMAN_HANDOFF.aprovar()",
        "timeout": "indefinido (espera aprovação humana)"
      }
    ]
  },
