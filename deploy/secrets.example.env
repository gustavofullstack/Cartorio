# Easypanel secrets — APENAS TEMPLATE
# Copie para /tmp/easypanel-secrets.env, preencha e use:
#   set -a; source /tmp/easypanel-secrets.env; set +a
#   UNIFY_DRY_RUN=1 node scripts/unify_services.sane.js
#   node scripts/unify_services.sane.js
#
# NUNCA commite o arquivo preenchido. .gitignore já protege deploy/secrets.env,
# /etc/cartorio/easypanel-secrets.env e /tmp/easypanel-secrets.env.

# Senha do role 'admin' do Postgres (cartorio_supabase)
POSTGRES_ADMIN_PASSWORD=

# Senha do Redis unificado (cartorio_redis)
REDIS_PASSWORD=

# Senha do role 'argilla_user' no db 'argilla'
ARGILLA_USER_PASSWORD=

# API key exposta para LobeChat (deve ser a do LiteLLM master, não uma real)
LOBECHAT_OPENAI_API_KEY=