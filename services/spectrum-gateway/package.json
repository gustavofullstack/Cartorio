{
  "name": "cartorio-spectrum-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file=.env src/index.ts",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "test": "tsx --test src/guardrails.test.ts src/hermes-executor.test.ts src/arena.test.ts src/arena-scenarios.test.ts src/arena-runner.test.ts src/arena-live.test.ts",
    "typecheck": "tsc --noEmit",
    "arena:probe": "tsx src/arena-live.ts probe"
  },
  "dependencies": {
    "@spectrum-ts/imessage": "^12.3.0",
    "spectrum-ts": "^12.3.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5"
  }
}
