# Nunca versione .env com segredos. Injete estes valores pelo secret manager.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# shared|test|limited → inbound_scope=allowlist (LIMITED_INBOUND).
# public exige linha dedicada Business + provider support; o processo recusa
# SPECTRUM_LINE_MODE=public até isso existir.
# PHOTON_ALLOW_ALL_USERS=true NÃO abre a linha ao público — só afeta users
# já registrados no projeto Spectrum.
SPECTRUM_LINE_MODE=shared
PHOTON_ALLOW_ALL_USERS=false

# URL interna do adaptador Hermes/OpenClaw. Sem esta configuração, o processo
# inicia em modo seguro, mas não responde mensagens.
HERMES_EXECUTOR_URL=
HERMES_EXECUTOR_TOKEN=
PORT=3080
