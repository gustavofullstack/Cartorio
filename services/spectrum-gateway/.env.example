# Nunca versione .env com segredos. Injete estes valores pelo secret manager.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# shared (padrão) permite resposta somente a contatos autorizados pelo provider.
# public exige linha dedicada/plano que documente inbound público.
SPECTRUM_LINE_MODE=shared
PHOTON_ALLOW_ALL_USERS=false

# URL interna do adaptador Hermes/OpenClaw. Sem esta configuração, o processo
# inicia em modo seguro, mas não responde mensagens.
HERMES_EXECUTOR_URL=
HERMES_EXECUTOR_TOKEN=
PORT=3080
