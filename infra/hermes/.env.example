# Non-secret deployment settings. Store the real deployment environment in the
# VPS/Easypanel secret manager, never in this repository.
HERMES_LLM_BASE_URL=http://<approved-openai-compatible-provider>/v1
HERMES_LLM_MODEL=<approved-model>
PHOTON_PROJECT_ID=<cartorio-photon-project-id>
PHOTON_ALLOWED_USERS=<comma-separated-E164-allowlist>

# Required Docker Secret names (contents must be created directly in the VPS
# secret manager; do not copy local Hermes credentials):
#   hermes_api_server_key
#   hermes_llm_api_key
#   hermes_mcp_cartorio_api_key
#   hermes_photon_project_secret
#   hermes_lark_app_id
#   hermes_lark_app_secret
#   hermes_lark_allowed_users
