      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.50, sum by (le, model) (rate(cartorio_llm_call_seconds_bucket[5m])))",
          "legendFormat": "p50 {{model}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(cartorio_llm_call_seconds_bucket[5m])))",
          "legendFormat": "p95 {{model}}",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (model) (rate(cartorio_llm_call_seconds_sum[5m])) / sum by (model) (rate(cartorio_llm_call_seconds_count[5m]))",
          "legendFormat": "avg {{model}}",
          "refId": "C"
        }
      ],
      "title": "Latência LLM p50 / p95 / média",
      "type": "timeseries"
    },
