          "refId": "A"
        }
      ],
      "title": "Rate de Chamadas LLM",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "p50/p95 de cartorio_llm_call_seconds por model. As séries p50/p95 usam histogram_quantile (disponível quando o exporter expuser buckets _bucket); a média (sum/count) funciona com o export summary atual.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
